<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LocationTracking" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/card</item>
        <item name="colorOnPrimary">@color/text</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/optional</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Surface and Surface colors -->
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/optional</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
    </style>

    <style name="Theme.LocationTracking" parent="Base.Theme.LocationTracking" />
</resources>